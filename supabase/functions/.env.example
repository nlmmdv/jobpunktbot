# Локальные секреты для `supabase functions serve` (НЕ коммитить реальный .env)
# Скопируй в supabase/functions/.env и запускай:
#   supabase functions serve --env-file supabase/functions/.env

# Разрешить dev-mode авторизацию (hash=dev-mode) БЕЗ проверки подписи.
# ТОЛЬКО для локальной разработки. В продакшене НЕ задавать — иначе обход авторизации.
ALLOW_DEV_AUTH=true

# Токен бота для верификации реальной подписи Telegram initData.
# В продакшене задаётся через секреты Supabase, а не здесь.
# TELEGRAM_JOBBOT_TOKEN=<bot_token_от_@BotFather>
